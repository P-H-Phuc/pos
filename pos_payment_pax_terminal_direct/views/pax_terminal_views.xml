<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pax_terminal_form" model="ir.ui.view">
        <field name="name">pax.terminal.form</field>
        <field name="model">pax.terminal</field>
        <field name="arch" type="xml">
            <form string="PAX Terminal">
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="btn-primary"
                        invisible="demo_mode"
                    />
                </header>
                <sheet>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="not demo_mode"
                    >
                        Demo Mode is active — no real terminal will be contacted.
                    </div>
                    <group>
                        <group string="General">
                            <field name="name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" widget="boolean_toggle" />
                            <field name="demo_mode" widget="boolean_toggle" />
                        </group>
                        <group string="Connection" invisible="demo_mode">
                            <field name="ip_address" placeholder="192.168.1.100" />
                            <field name="port" />
                            <field name="use_https" widget="boolean_toggle" />
                            <field name="timeout" />
                        </group>
                    </group>
                    <notebook>
                        <page string="POS Configurations">
                            <field name="pos_config_ids" widget="many2many_tags" />
                        </page>
                        <page string="Payment Methods">
                            <field name="payment_method_ids" readonly="True">
                                <list>
                                    <field name="name" />
                                    <field name="use_payment_terminal" />
                                </list>
                            </field>
                        </page>
                        <page string="Transaction Logs">
                            <field name="transaction_log_ids" readonly="True">
                                <list>
                                    <field name="transaction_date" />
                                    <field name="transaction_type" />
                                    <field name="amount" />
                                    <field name="reference" />
                                    <field name="success" />
                                    <field name="auth_code" />
                                    <field name="transaction_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pax_terminal_list" model="ir.ui.view">
        <field name="name">pax.terminal.list</field>
        <field name="model">pax.terminal</field>
        <field name="arch" type="xml">
            <list string="PAX Terminals">
                <field name="name" />
                <field name="ip_address" />
                <field name="port" />
                <field name="use_https" />
                <field name="demo_mode" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="action_pax_terminal" model="ir.actions.act_window">
        <field name="name">PAX Terminals</field>
        <field name="res_model">pax.terminal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pax_transaction_log_list" model="ir.ui.view">
        <field name="name">pax.transaction.log.list</field>
        <field name="model">pax.transaction.log</field>
        <field name="arch" type="xml">
            <list string="PAX Transactions" default_order="transaction_date desc">
                <field name="transaction_date" />
                <field name="terminal_id" />
                <field name="transaction_type" />
                <field name="amount" />
                <field name="reference" />
                <field name="success" widget="boolean" />
                <field name="auth_code" />
                <field name="last_four" />
                <field name="pos_order_id" />
            </list>
        </field>
    </record>

    <record id="view_pax_transaction_log_form" model="ir.ui.view">
        <field name="name">pax.transaction.log.form</field>
        <field name="model">pax.transaction.log</field>
        <field name="arch" type="xml">
            <form string="PAX Transaction Log" create="false">
                <sheet>
                    <group>
                        <group string="Transaction">
                            <field name="transaction_date" />
                            <field name="terminal_id" />
                            <field name="transaction_type" />
                            <field name="amount" />
                            <field name="reference" />
                            <field name="success" widget="boolean" />
                        </group>
                        <group string="Card / Auth">
                            <field name="auth_code" />
                            <field name="transaction_id" />
                            <field name="card_type" />
                            <field name="last_four" />
                            <field name="result_code" />
                            <field name="result_message" />
                        </group>
                    </group>
                    <group string="Links">
                        <field name="pos_order_id" />
                        <field name="pos_payment_id" />
                    </group>
                    <group string="Raw Response">
                        <field name="raw_response" nolabel="1" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pax_transaction_log" model="ir.actions.act_window">
        <field name="name">PAX Transactions</field>
        <field name="res_model">pax.transaction.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pax_root"
        name="PAX Terminals"
        parent="point_of_sale.menu_point_config_product"
        sequence="90"
    />
    <menuitem
        id="menu_pax_terminals"
        name="Terminals"
        parent="menu_pax_root"
        action="action_pax_terminal"
        sequence="10"
    />
    <menuitem
        id="menu_pax_transactions"
        name="Transactions"
        parent="menu_pax_root"
        action="action_pax_transaction_log"
        sequence="20"
    />
</odoo>
